# Dauerhafte Basis. UI-Änderungen gelten nur bis zum Worker-Neustart.
# Nach Dateiänderungen Webapp und Worker neu starten.
# Optional; ohne diese Werte gelten die Standardwerte:
# LLM_PROMPT="Vollständige Hörfassung, keine Zusammenfassung."
# FEED_TITLE="redread · Meine Artikel"
# PUBLIC_URL=http://dein-tailnet-host:3210
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemini-3.8-flash
LLM_API_KEY=

# fish: vollständige /v1/tts-URL; openai: Basis-URL ohne /audio/speech.
TTS_PROVIDER=fish
TTS_URL=https://api.fish.audio/v1/tts
TTS_MODEL=s2.1-pro-free
TTS_API_KEY=
# Bei Fish optional: reference_id. Bei OpenAI z.B. alloy.
TTS_VOICE=

# Globale Parallelitätslimits innerhalb des einzelnen Workers.
ARTICLE_CONCURRENCY=2
LLM_CONCURRENCY=3
TTS_CONCURRENCY=2
# Kürzere LLM-Abschnitte können gleichzeitig aufbereitet werden.
LLM_CHUNK_CHARS=3000
